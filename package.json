{
  "name": "hyperion-car-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123 -H 0.0.0.0",
    "predev": "node scripts/ensure-env.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "build": "prisma generate && next build",
    "start": "next start -p 43123 -H 0.0.0.0",
    "prestart": "node scripts/ensure-env.mjs && prisma migrate deploy && tsx prisma/seed.ts",
    "lint": "eslint",
    "test": "node --import tsx --test lib/domain.test.ts lib/history-sheet.test.ts lib/plates/mock.test.ts lib/client-search.test.ts lib/obra-number.test.ts lib/invoice-payload.test.ts",
    "build:pages": "vite build --config browser/vite.config.ts && node scripts/pack-pages.mjs",
    "setup": "node scripts/ensure-env.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:reset": "node scripts/ensure-env.mjs && rm -f data/hyperion.db data/hyperion.db-journal && prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.9",
    "idb": "^8.0.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.6"
  }
}
